+/** 貼り付け（continue）を n 回目まで止める。/clear は止めない */
+function holdSubmits(context: { mock: { method: typeof import("node:test").mock.method } }, n: number) {
+  const entered = Promise.withResolvers<void>();
+  const gate = Promise.withResolvers<void>();
+  const original = TuiSession.prototype.submit;
+  let count = 0;
+  context.mock.method(TuiSession.prototype, "submit", async function (this: TuiSession, text: string) {
+    if (text === "continue" && ++count <= n) {
+      if (count === n) entered.resolve();
+      await gate.promise;
+    }
+    return original.call(this, text);
+  });
+  return { entered: entered.promise, release: () => gate.resolve() };
+}
