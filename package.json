{
  "name": "pi-claude-code-tui",
  "version": "0.1.0",
  "description": "Experimental Pi provider that runs Claude Code\u0027s interactive TUI in a PTY, with Pi-managed tools and conversation history.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MINTY1st/pi-claude-code-tui.git"
  },
  "private": true,
  "keywords": [
    "pi-package",
    "claude",
    "claude-code",
    "anthropic"
  ],
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "docs",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
