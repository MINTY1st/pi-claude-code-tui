{
  "name": "@minty1st/pi-claude-code-tui",
  "version": "0.1.4",
  "description": "Experimental Pi provider that runs Claude Code's interactive TUI in a PTY, with Pi-managed tools and conversation history.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MINTY1st/pi-claude-code-tui.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi",
    "claude",
    "claude-code",
    "anthropic",
    "provider",
    "tui",
    "pty"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
